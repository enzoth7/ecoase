{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__ecoase_route=:path*" },
    { "source": "/mcp", "destination": "/api/index?__ecoase_route=mcp" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
